# AutoFormX 配置文件示例
# 复制此文件为 .env 并根据需要修改

# ===== API 配置 =====
PROVIDER=custom
API_BASE_URL=https://api.example.com/v1
API_KEY=your-api-key-here
CUSTOM_MODEL=your-model-name

# ===== 接口响应提取配置 =====
# 是否启用接口提取（默认不开启）
RESPONSE_CAPTURE_ENABLED=false

# 域名白名单（正则，多个用换行分隔）
RESPONSE_CAPTURE_DOMAIN_WHITELIST=glaiveentit\.i\.wxblockchain\.com

# 捕获规则（JSON 数组格式）
# 每条规则包含：name（规则名称）、urlPattern（接口URL正则）、extractPrompt（AI提取Prompt）、enabled（是否启用）
RESPONSE_CAPTURE_RULES=[{"name":"提取短信验证码","urlPattern":".*/api/v1/gw/captcha/smart$","extractPrompt":"提取接口响应中的短信验证码","enabled":true}]
